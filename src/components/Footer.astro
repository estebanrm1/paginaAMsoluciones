---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { site, solutions, waLink } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer tone-dark">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <Logo height={40} />
        <p class="claim">{site.tagline}.<br />Soluciones inteligentes que hacen avanzar los negocios.</p>
      </div>

      <nav class="cols" aria-label="Pie de página">
        <div>
          <p class="col-h">Soluciones</p>
          <ul role="list">
            {solutions.map((s) => <li><a href={`/soluciones/${s.slug}`}>{s.short}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="col-h">Enlace</p>
          <ul role="list">
            <li><a href="/#metodo">Cómo trabajamos</a></li>
            <li><a href="/nosotros">Nosotros</a></li>
            <li><a href="/#preguntas">Preguntas frecuentes</a></li>
          </ul>
        </div>
        <div>
          <p class="col-h">Contacto</p>
          <ul role="list">
            <li><a href="/contacto">Formulario de contacto</a></li>
            <li>
              <a href={waLink()} target="_blank" rel="noopener noreferrer">
                WhatsApp<span class="sr-only"> (abre en una pestaña nueva)</span>
              </a>
            </li>
            <li>
              <a href={site.instagram} target="_blank" rel="noopener noreferrer">
                Instagram<span class="sr-only"> (abre en una pestaña nueva)</span>
              </a>
            </li>
            <li>
              <a href={site.linkedin} target="_blank" rel="noopener noreferrer">
                LinkedIn<span class="sr-only"> (abre en una pestaña nueva)</span>
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="bottom">
      <p>© {year} {site.name} · {site.location}</p>
      <a class="up" href="#top">Volver arriba <Icon name="arrow" /></a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem) 2rem;
    border-top: 1px solid var(--line);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: 3rem;
  }
  .claim {
    margin-top: 1.25rem;
    color: var(--fg-3);
    max-width: 22rem;
    font-size: 0.95rem;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }
  .col-h {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-3);
    margin-bottom: 0.9rem;
  }
  .cols ul {
    display: grid;
    gap: 0.15rem;
  }
  .cols a {
    display: inline-block;
    padding-block: 0.3rem;
    color: var(--fg-2);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .cols a:hover {
    color: var(--fg);
    text-decoration: underline;
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: clamp(3rem, 2rem + 3vw, 5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.86rem;
    color: var(--fg-3);
  }
  .up {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    text-decoration: none;
    color: var(--fg-2);
  }
  .up :global(svg) {
    width: 1rem;
    height: 1rem;
    transform: rotate(-90deg);
  }
  .up:hover {
    color: var(--fg);
  }
  @media (max-width: 860px) {
    .top {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
