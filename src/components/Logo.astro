---
// Logo oficial vectorial de Enlace AR (generado con `npm run assets:brand` desde src/assets/brand/source/vector).
// variant: 'negativo' para fondos oscuros, 'color' para fondos claros. Se sirve como archivo SVG externo
// (cacheable) en lugar de incrustarlo, para no sumar ~45 KB a cada página.
import negativo from '../assets/brand/logo-horizontal-negativo.svg?url';
import color from '../assets/brand/logo-horizontal-color.svg?url';

interface Props {
  variant?: 'negativo' | 'color';
  height?: number;
  /** Texto alternativo. Vacío cuando el enlace contenedor ya tiene nombre accesible. */
  alt?: string;
  eager?: boolean;
  class?: string;
}
const RATIO = 1965.6 / 320.3; // viewBox recortado del logo horizontal
const { variant = 'negativo', height = 32, alt = 'Enlace AR', eager = false, class: cls } = Astro.props;
const src = variant === 'negativo' ? negativo : color;
---

<img
  src={src}
  alt={alt}
  width={Math.round(height * RATIO)}
  height={height}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  class:list={['logo', cls]}
/>

<style>
  .logo {
    display: block;
    width: auto;
    max-width: 100%;
  }
</style>
