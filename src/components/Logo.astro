---
// Marca Enlace AR: dos nodos unidos por un trazo continuo que avanza hacia un resultado
// (el nodo azul). Representa conectar negocio, sistemas y tecnología. Sin clichés.
interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 30, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg class="mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
    <rect width="32" height="32" rx="9" class="mark-bg" />
    <path d="M8.5 20.5c0-5 3.4-8.5 7.5-8.5s7.5 3.5 7.5 8.5" fill="none" class="mark-path" stroke-width="1.8" stroke-linecap="round" />
    <path d="M8.5 20.5h15" fill="none" class="mark-path dim" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="0.1 3.2" />
    <circle cx="8.5" cy="20.5" r="2.3" class="mark-node" />
    <circle cx="16" cy="12" r="1.6" class="mark-dot" />
    <circle cx="23.5" cy="20.5" r="2.7" fill="#477FF5" />
  </svg>
  {
    wordmark && (
      <span class="word">
        enlace<span class="ar">.ar</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .mark-bg {
    fill: color-mix(in srgb, var(--fg) 8%, transparent);
    stroke: var(--line-strong);
  }
  .mark-path {
    stroke: var(--fg);
  }
  .mark-path.dim {
    stroke: var(--fg-3);
  }
  .mark-node {
    fill: var(--bg);
    stroke: var(--fg);
    stroke-width: 1.5;
  }
  .mark-dot {
    fill: var(--fg);
  }
  .word {
    font-size: 1.12rem;
    font-weight: 650;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .ar {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.85em;
    letter-spacing: 0;
    color: var(--accent-text);
  }
</style>
