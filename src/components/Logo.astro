---
// Logo oficial de Enlace AR (generado desde src/assets/brand/source con `npm run assets:brand`).
// variant: 'reversed' para fondos oscuros (azul marino → blanco), 'color' para fondos claros.
// part: 'lockup' (símbolo | ENLACE AR) o 'mark' (solo el símbolo).
import { Image } from 'astro:assets';
import lockupReversed from '../assets/brand/lockup-reversed.png';
import lockupColor from '../assets/brand/lockup-color.png';
import markReversed from '../assets/brand/mark-reversed.png';
import markColor from '../assets/brand/mark-color.png';

interface Props {
  variant?: 'reversed' | 'color';
  part?: 'lockup' | 'mark';
  height?: number;
  /** Texto alternativo. Vacío cuando el enlace contenedor ya tiene nombre accesible. */
  alt?: string;
  eager?: boolean;
  class?: string;
}
const { variant = 'reversed', part = 'lockup', height = 32, alt = 'Enlace AR', eager = false, class: cls } = Astro.props;
const src = { lockup: { reversed: lockupReversed, color: lockupColor }, mark: { reversed: markReversed, color: markColor } }[part][variant];
const width = Math.round((src.width / src.height) * height);
---

<Image
  src={src}
  alt={alt}
  width={width}
  height={height}
  densities={[1, 2]}
  format="webp"
  quality={90}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  class:list={['logo', cls]}
/>

<style>
  .logo {
    display: block;
    width: auto;
    max-width: 100%;
  }
</style>
