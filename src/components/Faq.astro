---
// Preguntas frecuentes con <details>: accesible y funcional sin JavaScript.
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((it, i) => (
      <details data-reveal style={`--d:${i % 4}`}>
        <summary>
          <span>{it.q}</span>
          <span class="pm" aria-hidden="true" />
        </summary>
        <p>{it.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line-strong);
  }
  details {
    border-bottom: 1px solid var(--line-strong);
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    min-height: 3.5rem;
    padding-block: 1.15rem;
    cursor: pointer;
    list-style: none;
    font-size: var(--step-1);
    font-weight: 550;
    letter-spacing: -0.02em;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--accent-text);
  }
  .pm {
    position: relative;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.7rem;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
    transition: rotate 0.3s var(--ease);
  }
  .pm::after {
    rotate: 90deg;
  }
  details[open] .pm::after {
    rotate: 0deg;
  }
  details[open] .pm {
    border-color: var(--blue);
    color: var(--accent-text);
  }
  details p {
    padding-bottom: 1.4rem;
    max-width: 44rem;
    color: var(--fg-2);
  }
</style>
