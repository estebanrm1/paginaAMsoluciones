---
// Set de iconos propio, trazo uniforme de 1.6 (coherencia visual en todo el sitio).
interface Props {
  name: 'arrow' | 'arrow-up-right' | 'whatsapp' | 'instagram' | 'linkedin' | 'github' | 'menu' | 'close' | 'chevron' | 'check' | 'globe' | 'mail';
  class?: string;
}
const { name, class: cls } = Astro.props;
const stroke = { fill: 'none', stroke: 'currentColor', 'stroke-width': 1.6, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
---

{name === 'arrow' && <svg class:list={['i-arrow', cls]} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M5 12h14M13 6l6 6-6 6" /></svg>}
{name === 'arrow-up-right' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M7 17 17 7M8 7h9v9" /></svg>}
{name === 'chevron' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="m6 9 6 6 6-6" /></svg>}
{name === 'menu' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M4 8h16M4 16h16" /></svg>}
{name === 'close' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="M6 6l12 12M18 6 6 18" /></svg>}
{name === 'check' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><path d="m5 12.5 4.5 4.5L19 7.5" /></svg>}
{name === 'globe' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3Z" /></svg>}
{name === 'mail' && <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>}
{name === 'whatsapp' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
    <path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6Z" />
    <path d="M9.2 8.6c.2-.5.6-.6.9-.6h.4c.2 0 .4.1.5.4l.6 1.4c.1.2 0 .5-.1.7l-.5.6c.6 1.1 1.4 1.9 2.5 2.5l.6-.5c.2-.2.5-.2.7-.1l1.4.6c.3.1.4.3.4.5v.4c0 .3-.1.7-.6.9-.7.4-1.6.4-2.6 0a8.5 8.5 0 0 1-4.6-4.6c-.4-1-.4-1.9 0-2.6Z" stroke-width="1.2" />
  </svg>
)}
{name === 'instagram' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
    <rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="3.9" /><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
  </svg>
)}
{name === 'linkedin' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
    <rect x="3.5" y="3.5" width="17" height="17" rx="3" /><path d="M8 10.5V16M8 7.8v.1M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.3-2.6s2.2.9 2.2 2.6V16" />
  </svg>
)}
{name === 'github' && (
  <svg class={cls} viewBox="0 0 24 24" aria-hidden="true" {...stroke}>
    <path d="M9 19c-4 1.3-4-2-5.6-2.5M15 21v-3.3c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.7 4.7 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6.2 0C6.6 3 5.6 3.3 5.6 3.3a4.3 4.3 0 0 0-.1 3.2A4.7 4.7 0 0 0 4.2 9.7c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21" />
  </svg>
)}
