---
import Icon from './Icon.astro';
import { waLink } from '../data/site';

interface Props {
  title?: string;
  text?: string;
  /** Texto prellenado para WhatsApp (contextual a la página). */
  waText?: string;
  formHref?: string;
}
const {
  title = 'Contanos qué querés mejorar. Te ayudamos a encontrar cómo.',
  text = 'Una primera conversación alcanza para entender tu situación y proponerte un camino claro.',
  waText,
  formHref = '/contacto',
} = Astro.props;
---

<section class="cta tone-dark section" aria-labelledby="cta-title">
  <div class="grid-bg" aria-hidden="true"></div>
  <svg class="lines" viewBox="0 0 1200 400" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-20 320 C 260 320, 360 120, 600 120 S 940 300, 1220 260" />
    <path d="M-20 360 C 300 360, 420 200, 640 200 S 980 340, 1220 330" />
  </svg>
  <div class="wrap inner">
    <p class="kicker" data-reveal>Próximo paso</p>
    <h2 id="cta-title" class="title" data-reveal style="--d:1">{title}</h2>
    <p class="lede" data-reveal style="--d:2">{text}</p>
    <div class="actions" data-reveal style="--d:3">
      <a class="btn" href={formHref}>Completar el formulario <Icon name="arrow" /></a>
      <a class="btn btn--ghost" href={waLink(waText)} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" /> Escribinos por WhatsApp<span class="sr-only"> (abre en una pestaña nueva)</span>
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    overflow: hidden;
    border-top: 1px solid var(--line);
  }
  .inner {
    position: relative;
    text-align: center;
    display: grid;
    justify-items: center;
  }
  .title {
    max-width: 18ch;
  }
  .lede {
    margin-inline: auto;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }
  .lines {
    position: absolute;
    inset: auto 0 0 0;
    width: 100%;
    height: 70%;
    pointer-events: none;
  }
  .lines path {
    fill: none;
    stroke: var(--blue);
    stroke-width: 1;
    opacity: 0.35;
    vector-effect: non-scaling-stroke;
  }
  .lines path + path {
    opacity: 0.15;
  }
  @media (max-width: 520px) {
    .actions,
    .actions .btn {
      width: 100%;
    }
  }
</style>
